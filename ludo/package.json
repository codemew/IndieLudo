{
  "name": "ludo",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first realtime multiplayer Ludo",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && vitest run -c vitest.e2e.config.ts",
    "cert:mkcert": "node scripts/mkcert-help.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^23.11.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
